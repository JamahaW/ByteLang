def io = import("io.bl")
def random = import("random.bl")

pub def Grower = struct {
    pub name: []u8,
    cm: i32,

    def grow = fn(self: *Self) void {
        var profit: i32 = random.randint(-9999, 99)
        self.cm = self.cm + profit

        if profit > 0 {
            io.write("Player {} Sosal {} cm!", self.name, profit)
            return
        }

        var i: u8 = 10

        loop {
            if i == 0 { return }

            io.write("lox AKA '{}' Anti-grow {} cm..", self.name, profit)
            i = i - 1
        }
    }
}
