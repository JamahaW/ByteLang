// Пример актуального видения языка MizLang

//!core.miz
// Нативные функции и примитивы ядра языка

// Базовый целочисленный тип
pub def Integer = i32

// Сигнатуры нативных операций для работы со стеком и памятью
def UnaryOp = *sig(*Integer) void
def BinOp = *sig(*Integer, *Integer, *Integer) void
def MemoryOp = *sig(*void) void
def ControlOp = *sig(u32) void

// Примитивы управления программой
pub def exit = 0x00 as ControlOp           // Завершение программы
pub def call = 0x01 as *sig(*void, u8) void // Вызов функции
pub def ret = 0x02 as *sig() void          // Возврат из функции

// Примитивы работы со стеком и памятью
pub def push_address = 0x10 as MemoryOp    // Положить адрес на стек
pub def push_var = 0x11 as *sig(*Integer) void // Положить значение переменной
pub def push_const = 0x12 as *sig(Integer) void // Положить константу
pub def pop_in = 0x13 as *sig(*Integer) void   // Извлечь в переменную
pub def store = 0x14 as *sig(*Integer, Integer) void // Сохранить по адресу
pub def copy = 0x15 as *sig(*Integer, *Integer) void // Копировать переменные

// Базовые арифметические операции (нативные)
pub def add = 0x20 as BinOp      // *ret = *a + *b
pub def sub = 0x21 as BinOp      // *ret = *a - *b
pub def mul = 0x22 as BinOp      // *ret = *a * *b
pub def div = 0x23 as BinOp      // *ret = *a / *b
pub def inc = 0x24 as UnaryOp    // *ret = *ret + 1
pub def dec = 0x25 as UnaryOp    // *ret = *ret - 1


//!sketch.miz
// Пример использования возможностей языка

// Определение типов
def str = []u8

// Дженерик-структура
def Vector2 = fn(T: type) type {
    return struct {
        def Scalar = T,
        x: Scalar, y: Scalar,
    }
}

// Конкретизация дженерика
def Vector2i = Vector2(i32)

// Структура с методами
def User = struct {
    // Поля
    pub name: str,
    age: i32,

    // Статическое поле
    var static_count: i32 = 0,

    // Методы
    def init(self: *Self, name: str) void {
        self.name = name
        self.age = 0
        // Использование нативной операции напрямую
        var count_ptr: *i32 = &Self.static_count
        core.inc(count_ptr)
    },

    def get_age = fn(self: *Self) i32 {
        return self.age
    },

    def celebrate_birthday = fn(self: *Self) void {
        core.inc(&self.age)
    }
}

// Глобальные переменные
var global_counter: i32 = 0
var global_vector: Vector2i = { x: 100, y: 200 }
var global_user: User = undefined

// Нативная функция ввода (симуляция)
def input = cast(*sig() i32, 0x67)

// Публичная функция с низкоуровневым управлением
pub def lowlevel_calculate = fn(a: i32, b: *Vector2i) i32 {
    var temp: i32 = undefined
    var result: i32 = undefined

    // Низкоуровневые операции через ядро
    core.push_const(a)
    core.push_const(b.x)
    core.call(core.add, 8)
    core.pop_in(&temp)

    core.push_const(temp)
    core.push_const(b.y)
    core.call(core.add, 8)
    core.pop_in(&result)

    return result
}

// Функция с высокоуровневым синтаксисом
pub def highlevel_calculate = fn(a: i32, b: Vector2i) i32 {
    // Компилятор транслирует это в вызовы ядра
    return a + b.x + b.y
}

// Точка входа программы
def main = fn() void {
    // Инициализация структуры
    global_user.init("Alice")

    // Работа с локальными переменными
    var local_vec: Vector2i = { x: 10, y: 20 }
    var result: i32 = 0

    // Использование разных стилей программирования
    result = lowlevel_calculate(5, &local_vec)

    // Высокоуровневый вариант
    result = highlevel_calculate(5, local_vec)

    // Обновление глобальной переменной
    core.add(&global_counter, &result, &global_counter)

    // Вызов метода
    global_user.celebrate_birthday()
}
