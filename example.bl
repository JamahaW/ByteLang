// Показательный пример актуального видения языка ByteLang
//!core.bl
// Нативные функции ядра языка

// Определяем примитив для целочисленной арифметики
pub def Integer = i32

// Завершает исполнение программы
pub def exit = cast(*(code: u32)void, 0x00)

// Вызов пользовательской функции
// push IP, аллокация ret и локальных переменных
pub def call = cast(*(func_address: *void, stack_alloc: u8)void, 0x01)

// restore IP, освободить стек
pub def ret = cast(*()void, 0x02)

// *SP = *source
// Положить на стек адрес переменной
pub def push_address = cast(*(source: *void)void, 0x30)

// *SP = *source
// Положить на стек значение переменной
pub def push_var = cast(*(source: *Integer)void, 0x30)

// SP = source
// Положить на стек константу
pub def push_const = cast(*(source: Integer)void, 0x31)

// *dest = pop()
// Выложить со стека в переменную
pub def pop_in = cast(*(dest: *Integer)void, 0x33)

// *target = value
// Загрузить по адресу константу
pub def store = cast(*(target: *Integer, value: Integer)void, 0x20)

// *target = *source
// Копирование переменных
pub def copy = cast(*(target: *Integer, source: *Integer)void, 0x21)


//!math.bl
// Пользовательский модуль "Регистровая математика"

def core = import("core.bl")

// Сигнатура нативной функции для унарной операции
def UnaryOp = *(ret: *core.Integer)void

// Сигнатура нативной функции для бинарной операции
def BinOp = *(ret: *core.Integer, a: *core.Integer, b: *core.Integer)void

// Сложение
// *ret = *a + *b
pub def add = cast(BinOp, 0x10)

// Вычитание
// *ret = *a - *b
pub def sub = cast(BinOp, 0x11)

// Умножение
// *ret = *a * *b
pub def mul = cast(BinOp, 0x12)

// Деление
// *ret = *a / *b
pub def div = cast(BinOp, 0x13)

// Инкремент
// *ret = *ret + 1
pub def inc = cast(UnaryOp, 0x14)

// Декремент
// *ret = *ret - 1
pub def dec = cast(UnaryOp, 0x15)


//! sketch.bl
// Пользовательский скетч

// def - объявление символа

// Импорт - создание символа с значением модуля (import <path> -> структура)
def math = import("math.bl")

// Compile-time Загрузка внешних данных - создание символа с значением load <path>
def data = load("foo_data.bin")

// Type-Alias

def str = []u8

// Простая структура
def User = struct {
    // Имеет неявный символ def Self = <this-type>

    // Поля

    // Публичное поле
    pub name: str,

    // Приватное поле
    age: i32

    // Статические члены структуры

    // Статическая переменная структуры
    var static_variable: i32 = 0

    // Методы

    def init(self: *Self, name: str) void {
        self.name = name
        self.age = 0
    }

    // Метод экземпляра
    def getAge = fn(self: *Self) i32 {
        return self.age
    }
}

// Generic структура
def Vector2 = fn(T: type) type {
    return struct {
        def Scalar = T

        x: Scalar, y: Scalar
    }
}

// Создание символа конкретной структуры

def Vector2i = Vector2(i32)

var global_uninitialized_primitive: i32 = undefined

// Соглашение: компилятор имеет параметр <start-function> = main
// Запуск программы:
// core.call(main, <main-stack-size>)
// core.exit(0)

var global_struct: Vector2i = {
    123,
    456
}

pub var global_uninitialized_struct: Vector2i = undefined

// Некоторая пользовательская нативная инструкция для симуляции ввода
def input = cast(*fn()i32, 0x67)

// Публичная пользовательская функция
// stack_alloc: sizeof(i32) + sizeof(i32) = 4 + 4 = 8
pub def foo = fn(x: i32, vec: *Vector2i) i32 {
    var result: i32 = input()

    math.add(&result, &result, &x)
    math.add(&result, &result, &vec.x)
    math.add(&result, &result, &vec.y)

    return result
}

// Публичная пользовательская функция после развёртывания
// stack_alloc: sizeof(i32) + sizeof(i32) = 4 + 4 = 8
pub def foo_core = fn(x: i32, vec: *Vector2i) i32 {
    var ret: i32 = undefined
    var result: i32 = undefined

    input()
    core.pop_in(&result)

    math.add(&result, &result, &x)
    math.add(&result, &result, &vec.x)
    math.add(&result, &result, &vec.y)

    core.copy(&ret, &result)
    core.ret()
}

// Точка входа
def main = fn() void {
    // runtime инициализация
    global_uninitialized_primitive = 123456
    global_uninitialized_struct = { foo(input(), &global_struct), input() }

    // В core инструкциях:
    core.store(&global_uninitialized_primitive, 123456)

    input()                                         // global_uninitialized_struct.x = foo(input(), &global_struct)
    core.push_address(&global_struct)
    core.call(foo, 8)
    core.pop_in(&global_uninitialized_struct.x)


    input()                                         // global_uninitialized_struct.y = input()
    core.pop_in(&global_uninitialized_struct.y)

    // Неявный return
}